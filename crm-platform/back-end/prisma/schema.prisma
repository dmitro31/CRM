generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?

  firstName   String
  lastName    String?

  phone       String?
  avatar      String?

  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  provider    AuthProvider @default(LOCAL)

  oauthAccounts OAuthAccount[]

  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  uploadedFiles   File[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdRecords  Record[]

  refreshTokens      RefreshToken[]
  verificationToken  VerificationToken?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   invitationsSent Invitation[] @relation("InvitationSender")
}

model OAuthAccount {
  id String @id @default(uuid())

  provider OAuthProvider

  providerId String

  email String?

  accessToken String?
  refreshToken String?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model Workspace {
  id          String   @id @default(uuid())
  
  name        String
  slug        String   @unique
  description String?
  logo        String?

  ownerId     String
  owner       User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members     WorkspaceMember[]
  roles       Role[]
  modules     Module[]
  files       File[]
  workflows   Workflow[]
  auditLogs   AuditLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations Invitation[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId      String
  role        Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  joinedAt    DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Role {
  id          String   @id @default(uuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?

  permissions Json

  members WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   invitations Invitation[]

  @@unique([workspaceId, name])
}

model Module {
  id          String   @id @default(uuid())

  name        String
  key         String
  description String?

  icon        String?
  color       String?

  order       Int @default(0)

  isActive    Boolean @default(true)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fields      Field[]
  views       View[]
  records     Record[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  SELECT
  MULTI_SELECT
  FILE
  IMAGE
  RELATION
}

model Field {
  id           String   @id @default(uuid())

  name         String
  key          String

  type         FieldType

  description  String?

  required     Boolean @default(false)
  unique       Boolean @default(false)

  defaultValue Json?

  options Json?

  placeholder  String?

  order        Int

  isActive     Boolean @default(true)

  moduleId     String
  module       Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([moduleId, key])
  @@index([moduleId])
}

enum ViewType {
  TABLE
  BOARD
  CALENDAR
  LIST
}

model View {
  id          String   @id @default(uuid())

  name        String

  type        ViewType @default(TABLE)

  filters     Json?
  sorting     Json?
  columns     Json?

  icon        String?
  color       String?

  isDefault   Boolean @default(false)

  moduleId    String
  module      Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId])
}

model Record {
  id           String   @id @default(uuid())

  moduleId     String
  module       Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  data         Json

  createdById  String
  createdBy    User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  isArchived   Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([moduleId])
}

model File {
  id            String   @id @default(uuid())

  name          String
  originalName  String

  path          String
  extension     String
  mimeType      String
  size          Int

  uploadedById  String
  uploadedBy    User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([workspaceId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id          String   @id @default(uuid())

  title       String
  message     String

  type        NotificationType

  link        String?

  isRead      Boolean @default(false)

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())

  action      String
  entity      String
  entityId    String

  oldData     Json?
  newData     Json?

  ipAddress   String?
  userAgent   String?

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model Workflow {
  id          String   @id @default(uuid())

  name        String

  trigger     Json
  conditions  Json?
  actions     Json

  enabled     Boolean @default(true)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String   @id @default(uuid())

  token      String   @unique

  type       VerificationTokenType

  expiresAt  DateTime

  createdAt  DateTime @default(now())

  userId     String   @unique
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(uuid())

  tokenId    String   @unique

  tokenHash  String

  expiresAt  DateTime

  createdAt  DateTime @default(now())

  lastUsedAt DateTime?

  userAgent  String?
  ipAddress  String?

  revokedAt  DateTime?

  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@index([expiresAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id          String   @id @default(uuid())

  email       String

  token       String   @unique

  status      InvitationStatus @default(PENDING)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roleId      String
  role        Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  invitedById String
  invitedBy   User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  expiresAt   DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, email, status])
  @@index([workspaceId])
  @@index([token])
}