NODE_ENV=development
APP_NAME=CRM Platform
PORT=3000

DATABASE_URL="postgresql://postgres:your-password@localhost:5432/crm_platform?schema=public"

JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-secret
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

CORS_ORIGIN=http://localhost:5173

REDIS_HOST=localhost
REDIS_PORT=6379

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=your-minio-access-key
STORAGE_SECRET_KEY=your-minio-secret-key
STORAGE_BUCKET=crm-files

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

RESEND_API_KEY=
MAIL_APP_URL=http://localhost:3000